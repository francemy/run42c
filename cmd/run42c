#!/bin/bash

# ==========================================
# CONFIG
# ==========================================

CC="gcc"
CFLAGS="-Wall -Wextra -Werror"
OUTPUT="app"

# ==========================================
# COLORS
# ==========================================

GREEN="\033[0;32m"
RED="\033[0;31m"
BLUE="\033[0;34m"
YELLOW="\033[1;33m"
NC="\033[0m"

# ==========================================
# HELP
# ==========================================

show_help() {
    echo "Uso:"
    echo "  run42c [opções] [-- argumentos_do_programa]"
    echo ""
    echo "Opções:"
    echo "  -d        Compila com debug"
    echo "  -v        Executa com valgrind"
    echo "  -o NAME   Nome do executável"
    echo "  -h        Mostrar ajuda"
    echo ""
    echo "Exemplo:"
    echo "  run42c -d -- ola mundo"
    exit 0
}

# ==========================================
# OPTIONS
# ==========================================

USE_VALGRIND=0

while getopts "dvo:h" opt; do
    case $opt in
        d)
            CFLAGS="$CFLAGS -g"
            ;;
        v)
            USE_VALGRIND=1
            ;;
        o)
            OUTPUT="$OPTARG"
            ;;
        h)
            show_help
            ;;
        *)
            show_help
            ;;
    esac
done

shift $((OPTIND -1))

PROGRAM_ARGS="$@"

# ==========================================
# START
# ==========================================

clear

echo -e "${BLUE}==========================================${NC}"
echo -e "${BLUE}            RUN42c COMPILER                ${NC}"
echo -e "${BLUE}==========================================${NC}"

echo -e "${YELLOW}Compilando projeto...${NC}"

START=$(date +%s.%N)

# ==========================================
# FIND FILES
# ==========================================

FILES=$(find . -name "*.c")

if [ -z "$FILES" ]; then
    echo -e "${RED}Nenhum ficheiro .c encontrado.${NC}"
    exit 1
fi

# ==========================================
# COMPILE
# ==========================================

$CC $FILES $CFLAGS -o $OUTPUT

if [ $? -ne 0 ]; then
    echo ""
    echo -e "${RED}Compilação falhou.${NC}"
    exit 1
fi

END=$(date +%s.%N)

echo -e "${GREEN}Compilação concluída.${NC}"

echo ""
echo -e "${YELLOW}Executável:${NC} ./$OUTPUT"

echo ""
echo -e "${BLUE}------------------------------------------${NC}"
echo -e "${GREEN}Executando programa...${NC}"
echo -e "${BLUE}------------------------------------------${NC}"
echo ""

# ==========================================
# EXECUTE
# ==========================================

if [ $USE_VALGRIND -eq 1 ]; then
    valgrind ./$OUTPUT $PROGRAM_ARGS
else
    ./$OUTPUT $PROGRAM_ARGS
fi

STATUS=$?

echo ""
echo -e "${BLUE}------------------------------------------${NC}"

if [ $STATUS -eq 0 ]; then
    echo -e "${GREEN}Programa terminou com sucesso.${NC}"
else
    echo -e "${RED}Programa terminou com erro ($STATUS).${NC}"
fi

echo -e "${YELLOW}Tempo:${NC} $(echo "$END - $START" | bc)s"

echo -e "${BLUE}==========================================${NC}"
